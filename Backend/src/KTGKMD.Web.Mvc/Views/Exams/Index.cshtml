@using KTGKMD.Exams.Dto
@model List<ExamDto>
@{
    Layout = null;
    int totalExams = Model?.Count ?? 0;
    int activeExams = Model?.Count(e => e.IsActive) ?? 0;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title>Danh sách đề thi - TOEIC Reading Lecturer Master</title>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap" rel="stylesheet"/>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        "primary": "#004ac6",
                        "primary-container": "#2563eb",
                        "on-primary": "#ffffff",
                        "surface": "#f8f9ff",
                        "on-surface": "#0b1c30",
                        "surface-container-low": "#eff4ff",
                        "surface-container": "#e5eeff",
                        "surface-container-high": "#dce9ff",
                        "surface-container-highest": "#d3e4fe",
                        "surface-container-lowest": "#ffffff",
                        "on-surface-variant": "#434655",
                        "outline": "#737686",
                        "outline-variant": "#c3c6d7",
                        "secondary": "#006e2d",
                        "secondary-container": "#7cf994",
                        "error": "#ba1a1a",
                        "error-container": "#ffdad6"
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif']
                    }
                }
            }
        };
    </script>
</head>
<body class="bg-surface font-sans text-on-surface antialiased selection:bg-surface-container-high selection:text-primary min-h-screen">
    <!-- Top Navigation Header -->
    <header class="fixed top-0 w-full z-50 bg-white/90 backdrop-blur-md shadow-[0_1px_8px_rgba(15,23,42,0.06)] border-b border-outline-variant/40">
        <div class="h-16 w-full max-w-[1400px] mx-auto px-6 flex items-center justify-between gap-4">
            <div class="flex items-center gap-6">
                <a href="/Exams" class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-primary text-white flex items-center justify-center font-black shadow-sm">
                        <span class="material-symbols-outlined text-[24px]">menu_book</span>
                    </div>
                    <div class="flex flex-col">
                        <span class="font-bold text-base text-on-surface tracking-tight leading-none">TOEIC Reading</span>
                        <span class="text-xs text-on-surface-variant leading-tight">Hệ thống Quản lý Đề thi</span>
                    </div>
                </a>
                <div class="h-6 w-px bg-outline-variant/40 hidden md:block"></div>
                <nav class="hidden lg:flex items-center gap-1 p-1 bg-surface-container-low rounded-xl">
                    <a class="px-4 py-1.5 text-xs font-semibold rounded-lg bg-primary text-white shadow-sm transition-all" href="/Exams">Danh sách đề</a>
                    <a class="px-4 py-1.5 text-xs font-semibold text-on-surface-variant hover:text-on-surface rounded-lg transition-colors" href="/Exams/Upload">Nhập từ Word</a>
                    <a class="px-4 py-1.5 text-xs font-semibold text-on-surface-variant hover:text-on-surface rounded-lg transition-colors" href="/Exams/Edit/@(Model?.FirstOrDefault()?.Id ?? 1)">Sửa đề</a>
                    <a class="px-4 py-1.5 text-xs font-semibold text-on-surface-variant hover:text-on-surface rounded-lg transition-colors" href="/Exams/Preview/@(Model?.FirstOrDefault()?.Id ?? 1)">Xem trước</a>
                </nav>
            </div>
            <div class="flex items-center gap-4">
                <a class="inline-flex items-center gap-2 bg-primary hover:bg-primary-container text-white text-xs font-semibold px-4 py-2 rounded-lg shadow-sm transition-all" href="/Exams/Upload">
                    <span class="material-symbols-outlined text-[18px]">cloud_upload</span>
                    <span>+ Nhập đề từ Word</span>
                </a>
                <div class="flex items-center gap-3 pl-3 border-l border-outline-variant/40">
                    <div class="hidden sm:flex flex-col items-end text-right">
                        <span class="text-xs font-bold text-on-surface leading-tight">Giảng viên bộ môn</span>
                        <span class="text-[10px] px-1.5 py-0.5 rounded bg-surface-container-high text-on-surface-variant leading-none font-medium">Khoa Ngoại Ngữ</span>
                    </div>
                    <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center text-white">
                        <span class="material-symbols-outlined text-[18px]">person</span>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <main class="w-full pt-20 pb-16">
        <div class="max-w-[1400px] mx-auto px-6 flex flex-col gap-6">
            <!-- Alert Messages -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="p-4 rounded-xl bg-secondary-container/40 border border-secondary text-secondary font-medium text-sm flex items-center gap-2">
                    <span class="material-symbols-outlined text-[20px]">check_circle</span>
                    <span>@TempData["SuccessMessage"]</span>
                </div>
            }

            <!-- Top Analytics Header -->
            <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 bg-white p-6 rounded-2xl shadow-sm border border-outline-variant/30">
                <div class="flex flex-col gap-1 max-w-2xl">
                    <div class="inline-flex items-center gap-2">
                        <span class="px-2 py-0.5 rounded bg-surface-container text-xs text-primary font-bold uppercase tracking-wider">Khảo thí TOEIC</span>
                        <span class="text-outline-variant">•</span>
                        <span class="text-xs text-on-surface-variant font-mono">Phiên bản Web Admin</span>
                    </div>
                    <h1 class="text-2xl lg:text-3xl font-extrabold text-on-surface tracking-tight">Quản lý Đề thi TOEIC Reading</h1>
                    <p class="text-sm text-on-surface-variant leading-relaxed">
                        Hệ thống tự động phân tách cấu trúc Part 5 (câu độc lập), Part 6 (điền từ trong bài đọc) và Part 7 (đoạn văn đọc hiểu). Nhập trực tiếp từ file Word .docx chuẩn.
                    </p>
                </div>
                <!-- Metric Pills -->
                <div class="flex flex-wrap items-center gap-3">
                    <div class="flex items-center gap-3 px-4 py-2.5 rounded-xl bg-surface-container-low border border-outline-variant/30">
                        <span class="w-2.5 h-2.5 rounded-full bg-primary"></span>
                        <div class="flex flex-col">
                            <span class="text-[11px] text-on-surface-variant">Tổng số đề</span>
                            <span class="text-base font-bold text-on-surface leading-none">@totalExams</span>
                        </div>
                    </div>
                    <div class="flex items-center gap-3 px-4 py-2.5 rounded-xl bg-surface-container-low border border-outline-variant/30">
                        <span class="w-2.5 h-2.5 rounded-full bg-secondary"></span>
                        <div class="flex flex-col">
                            <span class="text-[11px] text-on-surface-variant">Đang hoạt động</span>
                            <span class="text-base font-bold text-secondary leading-none">@activeExams</span>
                        </div>
                    </div>
                    <a class="inline-flex items-center gap-2 bg-primary hover:bg-primary-container text-white text-xs font-semibold px-4 py-3 rounded-xl shadow-sm transition-all" href="/Exams/Upload">
                        <span class="material-symbols-outlined text-[20px]">add_circle</span>
                        <span>Tạo đề thi mới</span>
                    </a>
                </div>
            </div>

            <!-- Exam Master Table -->
            <div class="bg-white rounded-2xl shadow-sm border border-outline-variant/30 overflow-hidden flex flex-col">
                @if (Model == null || Model.Count == 0)
                {
                    <div class="text-center py-16 px-4 flex flex-col items-center">
                        <div class="w-16 h-16 rounded-2xl bg-surface-container-low text-outline flex items-center justify-center mb-4">
                            <span class="material-symbols-outlined text-[36px]">folder_off</span>
                        </div>
                        <h3 class="text-lg font-bold text-on-surface mb-1">Chưa có đề thi nào trong CSDL</h3>
                        <p class="text-sm text-on-surface-variant max-w-md mb-6">
                            Vui lòng nhập đề thi từ file Word (.docx) chuẩn format có bộ thẻ tags để kích hoạt hệ thống.
                        </p>
                        <a href="/Exams/Upload" class="inline-flex items-center gap-2 bg-primary text-white text-xs font-semibold px-5 py-2.5 rounded-lg shadow-sm">
                            <span class="material-symbols-outlined text-[18px]">cloud_upload</span>
                            <span>Tải lên đề thi ngay</span>
                        </a>
                    </div>
                }
                else
                {
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-surface-container-low/70 text-xs font-bold text-on-surface-variant uppercase tracking-wider border-b border-outline-variant/30">
                                    <th class="py-3.5 px-6">Tên đề thi & Cấu trúc</th>
                                    <th class="py-3.5 px-4 text-center w-32">Thời gian</th>
                                    <th class="py-3.5 px-4 text-center w-28">Số câu</th>
                                    <th class="py-3.5 px-4 w-44">Ngày tạo</th>
                                    <th class="py-3.5 px-4 w-36">Trạng thái</th>
                                    <th class="py-3.5 px-6 text-right w-48">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-surface-container-low text-sm">
                                @foreach (var exam in Model)
                                {
                                    <tr class="hover:bg-surface-container-low/40 transition-colors group">
                                        <td class="py-4 px-6">
                                            <div class="flex items-start gap-4">
                                                <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center shrink-0 mt-0.5">
                                                    <span class="material-symbols-outlined text-[22px]">description</span>
                                                </div>
                                                <div class="flex flex-col gap-0.5">
                                                    <div class="flex items-center gap-2">
                                                        <span class="text-base font-bold text-on-surface group-hover:text-primary transition-colors">@exam.Title</span>
                                                        <span class="px-2 py-0.5 rounded bg-surface-container text-primary text-[11px] font-bold">@exam.DurationMinutes phút</span>
                                                    </div>
                                                    <div class="text-xs text-on-surface-variant flex items-center gap-2">
                                                        <span>MÃ: TOEIC-RD-@exam.Id.ToString("D3")</span>
                                                        <span>•</span>
                                                        <span class="text-outline">@(string.IsNullOrEmpty(exam.Description) ? "Format chuẩn Part 5, 6, 7" : exam.Description)</span>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="py-4 px-4 text-center font-mono font-medium text-on-surface">
                                            <span class="px-2.5 py-1 rounded-lg bg-surface-container text-xs font-semibold text-primary">@exam.DurationMinutes phút</span>
                                        </td>
                                        <td class="py-4 px-4 text-center font-mono font-semibold text-on-surface">
                                            @exam.TotalQuestions câu
                                        </td>
                                        <td class="py-4 px-4 text-xs text-on-surface-variant">
                                            <div class="flex flex-col">
                                                <span class="font-medium text-on-surface">@exam.CreatedAt.ToString("dd/MM/yyyy")</span>
                                                <span class="font-mono text-outline text-[11px]">@exam.CreatedAt.ToString("HH:mm:ss")</span>
                                            </div>
                                        </td>
                                        <td class="py-4 px-4">
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-secondary-container/40 text-secondary text-xs font-bold">
                                                <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
                                                Đang hoạt động
                                            </span>
                                        </td>
                                        <td class="py-4 px-6 text-right">
                                            <div class="inline-flex items-center gap-1">
                                                <a href="/Exams/Preview/@exam.Id" class="p-2 text-on-surface-variant hover:text-primary hover:bg-surface-container rounded-lg transition-colors" title="Xem trước đề thi">
                                                    <span class="material-symbols-outlined text-[20px]">visibility</span>
                                                </a>
                                                <a href="/Exams/Edit/@exam.Id" class="p-2 text-on-surface-variant hover:text-primary hover:bg-surface-container rounded-lg transition-colors" title="Sửa nội dung đề thi">
                                                    <span class="material-symbols-outlined text-[20px]">edit</span>
                                                </a>
                                                <form action="/Exams/Delete/@exam.Id" method="post" style="display:inline;" onsubmit="return confirm('Bạn có chắc muốn xóa đề thi này?');">
                                                    <button type="submit" class="p-2 text-on-surface-variant hover:text-error hover:bg-error-container/40 rounded-lg transition-colors" title="Xóa đề thi">
                                                        <span class="material-symbols-outlined text-[20px]">delete</span>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </main>
</body>
</html>
