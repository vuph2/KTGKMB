@using KTGKMD.Exams.Dto
@model List<PassageDto>

<div class="card card-outline card-success shadow-sm mb-4">
    <div class="card-header bg-light">
        <h4 class="card-title font-weight-bold text-success mb-0">
            <i class="fas fa-book-open mr-1"></i> PART 7: Reading Comprehension (Đoạn văn đọc hiểu)
        </h4>
        <div class="card-tools">
            <span class="badge badge-success">@Model.Count bài đọc | @Model.Sum(p => p.Questions.Count) câu</span>
        </div>
    </div>
    <div class="card-body">
        @if (Model == null || Model.Count == 0)
        {
            <div class="text-muted text-center py-3">Không có bài đọc Part 7 nào trong đề này.</div>
        }
        else
        {
            @foreach (var passage in Model)
            {
                <div class="border rounded p-3 mb-4 bg-white shadow-sm">
                    <h5 class="font-weight-bold text-dark border-bottom pb-2">
                        <i class="fas fa-envelope-open-text text-success mr-2"></i>@(string.IsNullOrEmpty(passage.Title) ? "Bài đọc Part 7" : passage.Title)
                    </h5>

                    <div class="row mt-3">
                        <!-- COT BAI DOC -->
                        <div class="col-lg-7 mb-3">
                            <div class="bg-light p-3 rounded border" style="font-size: 0.95rem; line-height: 1.7; min-height: 250px;">
                                <div class="font-italic text-secondary mb-2"><i class="fas fa-file-alt mr-1"></i> Nội dung văn bản đọc hiểu:</div>
                                <div style="white-space: pre-wrap;">@passage.Content</div>

                                @if (!string.IsNullOrEmpty(passage.ImageUrl))
                                {
                                    <div class="mt-3 text-center">
                                        <img src="@passage.ImageUrl" alt="Hình ảnh bài đọc" class="img-fluid rounded border shadow-sm" style="max-height: 350px;" />
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- COT DANH SACH CAU HOI -->
                        <div class="col-lg-5">
                            <h6 class="font-weight-bold text-secondary mb-2"><i class="fas fa-question-circle mr-1"></i> Câu hỏi đọc hiểu:</h6>
                            @foreach (var q in passage.Questions.OrderBy(q => q.QuestionNumber))
                            {
                                <div class="border rounded p-3 mb-3 bg-white shadow-sm">
                                    <div class="font-weight-bold text-dark mb-2">
                                        <span class="badge badge-dark mr-1">Câu @q.QuestionNumber</span> @q.Content
                                    </div>
                                    <div class="pl-2">
                                        @foreach (var opt in q.Options)
                                        {
                                            <div class="py-1 @(opt.IsCorrect ? "text-success font-weight-bold" : "text-secondary")" style="font-size: 0.9rem;">
                                                <span class="badge @(opt.IsCorrect ? "badge-success" : "badge-light border") mr-1">(@opt.OptionLabel)</span>
                                                @opt.Content
                                                @if (opt.IsCorrect)
                                                {
                                                    <i class="fas fa-check text-success ml-1"></i>
                                                }
                                            </div>
                                        }
                                    </div>
                                    @if (!string.IsNullOrEmpty(q.Explanation))
                                    {
                                        <div class="mt-2 text-muted small bg-light p-2 rounded">
                                            <i class="fas fa-lightbulb text-warning mr-1"></i> @q.Explanation
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>
