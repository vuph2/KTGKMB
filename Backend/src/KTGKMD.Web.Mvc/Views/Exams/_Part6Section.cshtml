@using KTGKMD.Exams.Dto
@model List<PassageDto>

<div class="card card-outline card-info shadow-sm mb-4">
    <div class="card-header bg-light">
        <h4 class="card-title font-weight-bold text-info mb-0">
            <i class="fas fa-file-alt mr-1"></i> PART 6: Text Completion (Điền từ vào đoạn văn)
        </h4>
        <div class="card-tools">
            <span class="badge badge-info">@Model.Count đoạn văn | @Model.Sum(p => p.Questions.Count) câu</span>
        </div>
    </div>
    <div class="card-body">
        @if (Model == null || Model.Count == 0)
        {
            <div class="text-muted text-center py-3">Không có đoạn văn Part 6 nào trong đề này.</div>
        }
        else
        {
            @foreach (var passage in Model)
            {
                <div class="border rounded p-3 mb-4 bg-white shadow-sm">
                    <h5 class="font-weight-bold text-dark border-bottom pb-2">
                        <i class="fas fa-newspaper text-info mr-2"></i>@(string.IsNullOrEmpty(passage.Title) ? "Đoạn văn Part 6" : passage.Title)
                    </h5>

                    <div class="row mt-3">
                        <!-- COT BAI DOC -->
                        <div class="col-lg-7 mb-3">
                            <div class="bg-light p-3 rounded border" style="font-size: 0.95rem; line-height: 1.7; min-height: 200px;">
                                <div class="font-italic text-secondary mb-2"><i class="fas fa-quote-left mr-1"></i> Nội dung bài đọc:</div>
                                <div style="white-space: pre-wrap;">@passage.Content</div>

                                @if (!string.IsNullOrEmpty(passage.ImageUrl))
                                {
                                    <div class="mt-3 text-center">
                                        <img src="@passage.ImageUrl" alt="Hình ảnh bài đọc" class="img-fluid rounded border shadow-sm" style="max-height: 300px;" />
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- COT DANH SACH CAU HOI -->
                        <div class="col-lg-5">
                            <h6 class="font-weight-bold text-secondary mb-2"><i class="fas fa-list-ol mr-1"></i> Các câu hỏi tương ứng:</h6>
                            @foreach (var q in passage.Questions.OrderBy(q => q.QuestionNumber))
                            {
                                <div class="border rounded p-2 mb-2 bg-white">
                                    <div class="font-weight-bold text-dark mb-1">
                                        <span class="badge badge-dark">Câu @q.QuestionNumber</span> @(string.IsNullOrEmpty(q.Content) ? "" : q.Content)
                                    </div>
                                    <div class="row">
                                        @foreach (var opt in q.Options)
                                        {
                                            <div class="col-6 py-1 @(opt.IsCorrect ? "text-success font-weight-bold" : "text-secondary")" style="font-size: 0.88rem;">
                                                <span class="badge @(opt.IsCorrect ? "badge-success" : "badge-light border")">(@opt.OptionLabel)</span>
                                                @opt.Content
                                                @if (opt.IsCorrect)
                                                {
                                                    <i class="fas fa-check text-success ml-1"></i>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>
