@using KTGKMD.Exams.Dto
@model ExamDetailDto
@{
    Layout = null;
    var part5Questions = Model.Questions.Where(q => q.PartNumber == 5).OrderBy(q => q.QuestionNumber).ToList();
    var part6Passages = Model.Passages.Where(p => p.PartNumber == 6).OrderBy(p => p.PassageOrder).ToList();
    var part7Passages = Model.Passages.Where(p => p.PartNumber == 7).OrderBy(p => p.PassageOrder).ToList();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title>Xem trước Đề thi - @Model.Title</title>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet"/>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#004ac6",
                        "primary-container": "#2563eb",
                        "on-primary": "#ffffff",
                        "surface": "#f8f9ff",
                        "on-surface": "#0b1c30",
                        "surface-container-low": "#eff4ff",
                        "surface-container": "#e5eeff",
                        "surface-container-high": "#dce9ff",
                        "surface-container-highest": "#d3e4fe",
                        "surface-container-lowest": "#ffffff",
                        "on-surface-variant": "#434655",
                        "outline": "#737686",
                        "outline-variant": "#c3c6d7",
                        "secondary": "#006e2d",
                        "secondary-container": "#7cf994",
                        "tertiary": "#ae0010",
                        "error": "#ba1a1a",
                        "error-container": "#ffdad6"
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace']
                    }
                }
            }
        };
    </script>
    <style>
        .device-mobile-frame {
            max-width: 420px !important;
            border: 12px solid #1e293b;
            border-radius: 40px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
            margin: 0 auto;
        }
        .correct-answer-highlight {
            border-color: #10b981 !important;
            background-color: #ecfdf5 !important;
        }
    </style>
</head>
<body class="bg-surface font-sans text-on-surface antialiased selection:bg-surface-container-high selection:text-primary">
    <!-- TOP NAVIGATION HEADER -->
    <header class="fixed top-0 w-full z-50 bg-white/90 backdrop-blur-md shadow-[0_1px_8px_rgba(15,23,42,0.06)] border-b border-outline-variant/30">
        <div class="h-16 w-full max-w-[1440px] mx-auto px-6 flex items-center justify-between gap-4">
            <div class="flex items-center gap-6">
                <a href="/Exams" class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-primary text-white flex items-center justify-center font-black shadow-sm">
                        <span class="material-symbols-outlined text-[24px]">menu_book</span>
                    </div>
                    <div class="flex flex-col">
                        <span class="font-bold text-base text-on-surface tracking-tight leading-none">TOEIC Reading</span>
                        <span class="text-xs text-on-surface-variant leading-tight">Hệ thống Quản lý Đề thi</span>
                    </div>
                </a>
                <div class="h-6 w-px bg-outline-variant/40 hidden md:block"></div>
                <nav class="hidden lg:flex items-center gap-1 p-1 bg-surface-container-low rounded-xl">
                    <a class="px-4 py-1.5 text-xs font-semibold text-on-surface-variant hover:text-on-surface rounded-lg transition-colors" href="/Exams">Danh sách đề</a>
                    <a class="px-4 py-1.5 text-xs font-semibold text-on-surface-variant hover:text-on-surface rounded-lg transition-colors" href="/Exams/Upload">Nhập từ Word</a>
                    <a class="px-4 py-1.5 text-xs font-semibold text-on-surface-variant hover:text-on-surface rounded-lg transition-colors" href="/Exams/Edit/@Model.Id">Sửa đề</a>
                    <a class="px-4 py-1.5 text-xs font-semibold rounded-lg bg-primary text-white shadow-sm transition-all" href="/Exams/Preview/@Model.Id">Xem trước</a>
                </nav>
            </div>
            <div class="flex items-center gap-3">
                <a class="inline-flex items-center gap-1.5 bg-primary hover:bg-primary-container text-white text-xs font-bold px-4 py-2 rounded-xl shadow-sm transition-all" href="/Exams/Upload">
                    <span class="material-symbols-outlined text-[18px]">cloud_upload</span>
                    <span>+ Nhập đề từ Word</span>
                </a>
                <div class="flex items-center gap-2 pl-3 border-l border-outline-variant/40">
                    <div class="hidden sm:flex flex-col items-end text-right">
                        <span class="text-xs font-bold text-on-surface leading-tight">Giảng viên phụ trách</span>
                        <span class="text-[10px] px-1.5 py-0.5 rounded bg-surface-container-high text-on-surface-variant font-medium">Lecturer</span>
                    </div>
                    <div class="w-8 h-8 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold">
                        <span class="material-symbols-outlined text-[18px]">person</span>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <main class="w-full pt-16 min-h-screen bg-surface flex flex-col">
        <!-- PREVIEW CONTROL PANEL FROM STITCH -->
        <section class="w-full bg-white border-b border-outline-variant/30 shadow-sm z-30 sticky top-16">
            <div class="w-full max-w-[1440px] mx-auto px-6 py-3 flex flex-wrap items-center justify-between gap-4">
                <!-- Left: Breadcrumbs & Title -->
                <div class="flex items-center gap-4 min-w-0">
                    <div class="flex flex-col min-w-0">
                        <div class="flex items-center gap-1.5 text-on-surface-variant text-xs font-medium">
                            <a class="hover:text-primary transition-colors" href="/Exams">Danh sách đề</a>
                            <span class="material-symbols-outlined text-[13px] text-outline">chevron_right</span>
                            <span class="text-on-surface font-semibold">Xem trước học viên</span>
                        </div>
                        <div class="flex items-center gap-2.5 mt-0.5">
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full bg-primary/10 text-primary text-[10px] font-mono font-bold tracking-wider">
                                PREVIEW MODE
                            </span>
                            <h1 class="text-base font-extrabold text-on-surface truncate">
                                @Model.Title
                            </h1>
                        </div>
                    </div>
                </div>

                <!-- Center: Controls -->
                <div class="flex items-center gap-4 flex-wrap">
                    <!-- Toggle Hiện đáp án & giải thích -->
                    <label class="flex items-center gap-2.5 cursor-pointer select-none px-3.5 py-1.5 rounded-xl bg-surface-container-low hover:bg-surface-container border border-outline-variant/30 transition-all">
                        <input checked id="toggleAnswers" type="checkbox" class="w-4 h-4 text-primary rounded focus:ring-primary" onchange="toggleAnswersView(this.checked)"/>
                        <div class="flex flex-col">
                            <span class="text-xs font-bold text-on-surface flex items-center gap-1.5">
                                Hiện đáp án đúng & giải thích
                                <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                            </span>
                            <span class="text-[10px] text-on-surface-variant font-medium">Chế độ chấm bài trực tiếp</span>
                        </div>
                    </label>

                    <!-- Frame Switcher Desktop vs Mobile -->
                    <div class="inline-flex items-center bg-surface-container-low p-1 rounded-xl border border-outline-variant/30">
                        <button class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white shadow-sm text-xs font-bold text-primary transition-all" id="btnDesktop" onclick="setDeviceView('desktop')" type="button">
                            <span class="material-symbols-outlined text-[16px]">desktop_windows</span>
                            <span>Desktop (1440px)</span>
                        </button>
                        <button class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg hover:text-on-surface text-xs font-medium text-on-surface-variant transition-all" id="btnMobile" onclick="setDeviceView('mobile')" type="button">
                            <span class="material-symbols-outlined text-[16px]">smartphone</span>
                            <span>Mobile (390px)</span>
                        </button>
                    </div>
                </div>

                <!-- Right Actions -->
                <div class="flex items-center gap-2">
                    <a class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-surface-container hover:bg-surface-container-high text-primary font-bold text-xs transition-all" href="/Exams/Edit/@Model.Id">
                        <span class="material-symbols-outlined text-[16px]">edit</span>
                        <span>Sửa đề này</span>
                    </a>
                    <a class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-surface-container-low hover:bg-surface-container text-on-surface font-semibold text-xs transition-all" href="/Exams">
                        <span class="material-symbols-outlined text-[16px]">close</span>
                        <span>Thoát</span>
                    </a>
                </div>
            </div>
        </section>

        <!-- WORKSPACE WRAPPER (Handles Desktop vs Mobile Preview Frame) -->
        <section class="w-full py-6 px-4 md:px-8 flex justify-center bg-surface flex-1">
            <div class="w-full max-w-[1380px] transition-all duration-300 flex flex-col gap-6" id="simulatorContainer">
                
                <!-- STUDENT TOP BAR (Perspective Thí sinh) -->
                <div class="bg-white rounded-2xl p-4 shadow-sm border border-outline-variant/30 flex flex-wrap items-center justify-between gap-4">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-primary text-white flex items-center justify-center font-bold">
                            <span class="material-symbols-outlined text-[20px]">assignment</span>
                        </div>
                        <div>
                            <div class="flex items-center gap-2">
                                <h2 class="text-sm font-bold text-on-surface">@Model.Title</h2>
                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-secondary-container/50 text-secondary">CHÍNH THỨC</span>
                            </div>
                            <span class="text-xs text-on-surface-variant">Tổng số: <strong>@Model.Questions.Count câu hỏi</strong> (Part 5: @part5Questions.Count, Part 6: @part6Passages.Sum(p => p.Questions.Count), Part 7: @part7Passages.Sum(p => p.Questions.Count))</span>
                        </div>
                    </div>

                    <div class="flex items-center gap-4">
                        <!-- Simulated Countdown Timer -->
                        <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-surface-container-low border border-outline-variant/30">
                            <span class="material-symbols-outlined text-primary text-[20px] animate-pulse">timer</span>
                            <div class="flex flex-col leading-tight">
                                <span class="text-[9px] uppercase font-bold text-on-surface-variant">Thời gian làm bài</span>
                                <span class="text-base font-black font-mono text-primary">@Model.DurationMinutes:00</span>
                            </div>
                        </div>

                        <!-- Filter Part Tabs -->
                        <div class="flex items-center gap-1 bg-surface-container-low p-1 rounded-xl">
                            <button onclick="filterPart('all')" id="btn-part-all" class="px-3 py-1 rounded-lg text-xs font-bold bg-primary text-white shadow-sm">Tất cả</button>
                            <button onclick="filterPart('5')" id="btn-part-5" class="px-3 py-1 rounded-lg text-xs font-semibold text-on-surface-variant hover:text-on-surface">Part 5 (@part5Questions.Count)</button>
                            <button onclick="filterPart('6')" id="btn-part-6" class="px-3 py-1 rounded-lg text-xs font-semibold text-on-surface-variant hover:text-on-surface">Part 6 (@part6Passages.Sum(p => p.Questions.Count))</button>
                            <button onclick="filterPart('7')" id="btn-part-7" class="px-3 py-1 rounded-lg text-xs font-semibold text-on-surface-variant hover:text-on-surface">Part 7 (@part7Passages.Sum(p => p.Questions.Count))</button>
                        </div>
                    </div>
                </div>

                <!-- ============================================== -->
                <!-- PART 5: CÂU HỎI ĐỘC LẬP (Q101 - Q130)           -->
                <!-- ============================================== -->
                <div class="part-section space-y-4" id="section-part-5">
                    <div class="flex items-center gap-2 px-2">
                        <span class="w-7 h-7 rounded-lg bg-primary text-white flex items-center justify-center font-bold text-xs">P5</span>
                        <h3 class="text-base font-extrabold text-on-surface">Part 5: Incomplete Sentences (Câu 101 - 130)</h3>
                        <span class="text-xs text-on-surface-variant font-medium">• @part5Questions.Count câu hỏi độc lập</span>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        @foreach (var q in part5Questions)
                        {
                            <div class="bg-white rounded-2xl p-5 shadow-sm border border-outline-variant/30 space-y-3">
                                <div class="flex items-center justify-between">
                                    <span class="px-2.5 py-1 rounded-lg bg-surface-container font-mono font-bold text-xs text-primary">Câu @q.QuestionNumber</span>
                                    <span class="text-[11px] font-semibold text-on-surface-variant">Part 5</span>
                                </div>
                                <p class="text-xs font-medium text-on-surface leading-relaxed">@q.Content</p>
                                
                                <div class="space-y-1.5 pt-1">
                                    @foreach (var opt in q.Options.OrderBy(o => o.OptionLabel))
                                    {
                                        <div class="option-item flex items-center gap-2.5 p-2 rounded-xl border border-outline-variant/20 transition-all text-xs @(opt.IsCorrect ? "correct-answer-highlight font-bold" : "text-on-surface")" data-is-correct="@(opt.IsCorrect ? "true" : "false")">
                                            <span class="w-6 h-6 rounded-lg @(opt.IsCorrect ? "bg-emerald-600 text-white" : "bg-surface-container text-on-surface-variant") flex items-center justify-center font-bold text-[11px] shrink-0">
                                                @opt.OptionLabel
                                            </span>
                                            <span class="flex-1">@opt.Content</span>
                                            @if (opt.IsCorrect)
                                            {
                                                <span class="correct-badge material-symbols-outlined text-emerald-600 text-[18px]">check_circle</span>
                                            }
                                        </div>
                                    }
                                </div>

                                @if (!string.IsNullOrEmpty(q.Explanation))
                                {
                                    <div class="explanation-box p-3 rounded-xl bg-surface-container-low text-[11px] text-on-surface-variant border border-outline-variant/20 mt-2">
                                        💡 <strong>Giải thích:</strong> @q.Explanation
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <!-- ============================================== -->
                <!-- PART 6: ĐIỀN ĐOẠN VĂN (Q131 - Q146) - SPLIT VIEW-->
                <!-- ============================================== -->
                <div class="part-section space-y-6 pt-4" id="section-part-6">
                    <div class="flex items-center gap-2 px-2">
                        <span class="w-7 h-7 rounded-lg bg-secondary text-white flex items-center justify-center font-bold text-xs">P6</span>
                        <h3 class="text-base font-extrabold text-on-surface">Part 6: Text Completion (Câu 131 - 146)</h3>
                        <span class="text-xs text-on-surface-variant font-medium">• @part6Passages.Count bài đọc (@part6Passages.Sum(p => p.Questions.Count) câu hỏi)</span>
                    </div>

                    @foreach (var p in part6Passages)
                    {
                        <div class="bg-white rounded-2xl shadow-sm border border-outline-variant/30 overflow-hidden">
                            <div class="bg-surface-container-low px-5 py-3 border-b border-outline-variant/20 flex items-center justify-between">
                                <span class="text-xs font-bold text-primary flex items-center gap-1.5">
                                    <span class="material-symbols-outlined text-[16px]">description</span>
                                    @(string.IsNullOrEmpty(p.Title) ? $"Đoạn văn số {p.PassageOrder}" : p.Title)
                                </span>
                                <span class="text-[11px] font-semibold text-on-surface-variant">@(p.Questions.Count) câu hỏi liên quan</span>
                            </div>

                            <div class="grid grid-cols-1 lg:grid-cols-2 divide-y lg:divide-y-0 lg:divide-x divide-outline-variant/20">
                                <!-- Trái: Bài đọc -->
                                <div class="p-6 bg-surface-container-low/20">
                                    @if (!string.IsNullOrEmpty(p.ImageUrl))
                                    {
                                        <img src="@p.ImageUrl" alt="Passage Image" class="rounded-xl mb-4 max-h-60 object-contain border border-outline-variant/20 mx-auto" />
                                    }
                                    <div class="text-xs text-on-surface leading-relaxed whitespace-pre-line font-serif font-normal bg-white p-5 rounded-xl border border-outline-variant/20 shadow-inner">
                                        @p.Content
                                    </div>
                                </div>

                                <!-- Phải: Danh sách câu hỏi -->
                                <div class="p-6 space-y-4">
                                    @foreach (var q in p.Questions.OrderBy(q => q.QuestionNumber))
                                    {
                                        <div class="p-4 rounded-xl border border-outline-variant/20 bg-white space-y-2.5">
                                            <div class="flex items-center justify-between">
                                                <span class="font-bold text-xs text-primary font-mono">Câu @q.QuestionNumber</span>
                                                @if (!string.IsNullOrEmpty(q.Content))
                                                {
                                                    <span class="text-xs text-on-surface-variant">@q.Content</span>
                                                }
                                            </div>
                                            <div class="space-y-1.5">
                                                @foreach (var opt in q.Options.OrderBy(o => o.OptionLabel))
                                                {
                                                    <div class="option-item flex items-center gap-2 p-1.5 rounded-lg border border-outline-variant/20 text-xs @(opt.IsCorrect ? "correct-answer-highlight font-bold" : "text-on-surface")" data-is-correct="@(opt.IsCorrect ? "true" : "false")">
                                                        <span class="w-5 h-5 rounded @(opt.IsCorrect ? "bg-emerald-600 text-white" : "bg-surface-container text-on-surface-variant") flex items-center justify-center font-bold text-[10px] shrink-0">
                                                            @opt.OptionLabel
                                                        </span>
                                                        <span class="flex-1">@opt.Content</span>
                                                        @if (opt.IsCorrect)
                                                        {
                                                            <span class="correct-badge material-symbols-outlined text-emerald-600 text-[16px]">check_circle</span>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                            @if (!string.IsNullOrEmpty(q.Explanation))
                                            {
                                                <div class="explanation-box p-2 rounded-lg bg-surface-container-low text-[11px] text-on-surface-variant">
                                                    💡 <strong>Giải thích:</strong> @q.Explanation
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- ============================================== -->
                <!-- PART 7: ĐỌC HIỂU (Q147 - Q200) - SPLIT VIEW     -->
                <!-- ============================================== -->
                <div class="part-section space-y-6 pt-4" id="section-part-7">
                    <div class="flex items-center gap-2 px-2">
                        <span class="w-7 h-7 rounded-lg bg-indigo-600 text-white flex items-center justify-center font-bold text-xs">P7</span>
                        <h3 class="text-base font-extrabold text-on-surface">Part 7: Reading Comprehension (Câu 147 - 200)</h3>
                        <span class="text-xs text-on-surface-variant font-medium">• @part7Passages.Count bài đọc đơn & kép (@part7Passages.Sum(p => p.Questions.Count) câu hỏi)</span>
                    </div>

                    @foreach (var p in part7Passages)
                    {
                        <div class="bg-white rounded-2xl shadow-sm border border-outline-variant/30 overflow-hidden">
                            <div class="bg-surface-container-low px-5 py-3 border-b border-outline-variant/20 flex items-center justify-between">
                                <span class="text-xs font-bold text-primary flex items-center gap-1.5">
                                    <span class="material-symbols-outlined text-[16px]">article</span>
                                    @(string.IsNullOrEmpty(p.Title) ? $"Đoạn văn đọc hiểu số {p.PassageOrder}" : p.Title)
                                </span>
                                <span class="text-[11px] font-semibold text-on-surface-variant">@(p.Questions.Count) câu hỏi</span>
                            </div>

                            <div class="grid grid-cols-1 lg:grid-cols-2 divide-y lg:divide-y-0 lg:divide-x divide-outline-variant/20">
                                <!-- Trái: Bài đọc -->
                                <div class="p-6 bg-surface-container-low/20">
                                    @if (!string.IsNullOrEmpty(p.ImageUrl))
                                    {
                                        <img src="@p.ImageUrl" alt="Passage Image" class="rounded-xl mb-4 max-h-72 object-contain border border-outline-variant/20 mx-auto" />
                                    }
                                    <div class="text-xs text-on-surface leading-relaxed whitespace-pre-line font-serif font-normal bg-white p-5 rounded-xl border border-outline-variant/20 shadow-inner">
                                        @p.Content
                                    </div>
                                </div>

                                <!-- Phải: Danh sách câu hỏi -->
                                <div class="p-6 space-y-4">
                                    @foreach (var q in p.Questions.OrderBy(q => q.QuestionNumber))
                                    {
                                        <div class="p-4 rounded-xl border border-outline-variant/20 bg-white space-y-2.5">
                                            <div class="flex items-center justify-between">
                                                <span class="font-bold text-xs text-primary font-mono">Câu @q.QuestionNumber</span>
                                                @if (!string.IsNullOrEmpty(q.Content))
                                                {
                                                    <span class="text-xs font-medium text-on-surface">@q.Content</span>
                                                }
                                            </div>
                                            <div class="space-y-1.5">
                                                @foreach (var opt in q.Options.OrderBy(o => o.OptionLabel))
                                                {
                                                    <div class="option-item flex items-center gap-2 p-1.5 rounded-lg border border-outline-variant/20 text-xs @(opt.IsCorrect ? "correct-answer-highlight font-bold" : "text-on-surface")" data-is-correct="@(opt.IsCorrect ? "true" : "false")">
                                                        <span class="w-5 h-5 rounded @(opt.IsCorrect ? "bg-emerald-600 text-white" : "bg-surface-container text-on-surface-variant") flex items-center justify-center font-bold text-[10px] shrink-0">
                                                            @opt.OptionLabel
                                                        </span>
                                                        <span class="flex-1">@opt.Content</span>
                                                        @if (opt.IsCorrect)
                                                        {
                                                            <span class="correct-badge material-symbols-outlined text-emerald-600 text-[16px]">check_circle</span>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                            @if (!string.IsNullOrEmpty(q.Explanation))
                                            {
                                                <div class="explanation-box p-2 rounded-lg bg-surface-container-low text-[11px] text-on-surface-variant">
                                                    💡 <strong>Giải thích:</strong> @q.Explanation
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>

            </div>
        </section>
    </main>

    <script>
        function toggleAnswersView(show) {
            const items = document.querySelectorAll('.option-item');
            const badges = document.querySelectorAll('.correct-badge');
            const explanations = document.querySelectorAll('.explanation-box');

            items.forEach(el => {
                const isCorrect = el.getAttribute('data-is-correct') === 'true';
                if (show) {
                    if (isCorrect) {
                        el.classList.add('correct-answer-highlight', 'font-bold');
                    }
                } else {
                    el.classList.remove('correct-answer-highlight', 'font-bold');
                }
            });

            badges.forEach(b => {
                b.style.display = show ? 'inline-block' : 'none';
            });

            explanations.forEach(exp => {
                exp.style.display = show ? 'block' : 'none';
            });
        }

        function setDeviceView(mode) {
            const container = document.getElementById('simulatorContainer');
            const btnDesktop = document.getElementById('btnDesktop');
            const btnMobile = document.getElementById('btnMobile');

            if (mode === 'mobile') {
                container.classList.add('device-mobile-frame');
                btnMobile.classList.add('bg-white', 'shadow-sm', 'text-primary', 'font-bold');
                btnMobile.classList.remove('text-on-surface-variant');
                btnDesktop.classList.remove('bg-white', 'shadow-sm', 'text-primary', 'font-bold');
                btnDesktop.classList.add('text-on-surface-variant');
            } else {
                container.classList.remove('device-mobile-frame');
                btnDesktop.classList.add('bg-white', 'shadow-sm', 'text-primary', 'font-bold');
                btnDesktop.classList.remove('text-on-surface-variant');
                btnMobile.classList.remove('bg-white', 'shadow-sm', 'text-primary', 'font-bold');
                btnMobile.classList.add('text-on-surface-variant');
            }
        }

        function filterPart(part) {
            const p5 = document.getElementById('section-part-5');
            const p6 = document.getElementById('section-part-6');
            const p7 = document.getElementById('section-part-7');

            ['all', '5', '6', '7'].forEach(p => {
                const btn = document.getElementById(`btn-part-${p}`);
                if (btn) {
                    if (p === part) {
                        btn.className = "px-3 py-1 rounded-lg text-xs font-bold bg-primary text-white shadow-sm";
                    } else {
                        btn.className = "px-3 py-1 rounded-lg text-xs font-semibold text-on-surface-variant hover:text-on-surface";
                    }
                }
            });

            if (part === 'all') {
                if (p5) p5.style.display = 'block';
                if (p6) p6.style.display = 'block';
                if (p7) p7.style.display = 'block';
            } else if (part === '5') {
                if (p5) p5.style.display = 'block';
                if (p6) p6.style.display = 'none';
                if (p7) p7.style.display = 'none';
            } else if (part === '6') {
                if (p5) p5.style.display = 'none';
                if (p6) p6.style.display = 'block';
                if (p7) p7.style.display = 'none';
            } else if (part === '7') {
                if (p5) p5.style.display = 'none';
                if (p6) p6.style.display = 'none';
                if (p7) p7.style.display = 'block';
            }
        }
    </script>
</body>
</html>
