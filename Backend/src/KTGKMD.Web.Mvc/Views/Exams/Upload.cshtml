@using KTGKMD.Exams.Dto
@model DocxParseResultDto
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title>Nhập đề từ Word - TOEIC Reading Lecturer Master</title>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap" rel="stylesheet"/>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        "primary": "#004ac6",
                        "primary-container": "#2563eb",
                        "on-primary": "#ffffff",
                        "surface": "#f8f9ff",
                        "on-surface": "#0b1c30",
                        "surface-container-low": "#eff4ff",
                        "surface-container": "#e5eeff",
                        "surface-container-high": "#dce9ff",
                        "surface-container-highest": "#d3e4fe",
                        "surface-container-lowest": "#ffffff",
                        "on-surface-variant": "#434655",
                        "outline": "#737686",
                        "outline-variant": "#c3c6d7",
                        "secondary": "#006e2d",
                        "secondary-container": "#7cf994",
                        "error": "#ba1a1a",
                        "error-container": "#ffdad6"
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['Courier New', 'monospace']
                    }
                }
            }
        };
    </script>
</head>
<body class="bg-surface font-sans text-on-surface antialiased selection:bg-surface-container-high selection:text-primary min-h-screen">
    <!-- Top Navigation Header -->
    <header class="fixed top-0 w-full z-50 bg-white/90 backdrop-blur-md shadow-[0_1px_8px_rgba(15,23,42,0.06)] border-b border-outline-variant/40">
        <div class="h-16 w-full max-w-[1400px] mx-auto px-6 flex items-center justify-between gap-4">
            <div class="flex items-center gap-6">
                <a href="/Exams" class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-primary text-white flex items-center justify-center font-black shadow-sm">
                        <span class="material-symbols-outlined text-[24px]">menu_book</span>
                    </div>
                    <div class="flex flex-col">
                        <span class="font-bold text-base text-on-surface tracking-tight leading-none">TOEIC Reading</span>
                        <span class="text-xs text-on-surface-variant leading-tight">Hệ thống Quản lý Đề thi</span>
                    </div>
                </a>
                <div class="h-6 w-px bg-outline-variant/40 hidden md:block"></div>
                <nav class="hidden lg:flex items-center gap-1 p-1 bg-surface-container-low rounded-xl">
                    <a class="px-4 py-1.5 text-xs font-semibold text-on-surface-variant hover:text-on-surface rounded-lg transition-colors" href="/Exams">Danh sách đề</a>
                    <a class="px-4 py-1.5 text-xs font-semibold rounded-lg bg-primary text-white shadow-sm transition-all" href="/Exams/Upload">Nhập từ Word</a>
                    <a class="px-4 py-1.5 text-xs font-semibold text-on-surface-variant hover:text-on-surface rounded-lg transition-colors" href="/Exams/Edit/1">Sửa đề</a>
                    <a class="px-4 py-1.5 text-xs font-semibold text-on-surface-variant hover:text-on-surface rounded-lg transition-colors" href="/Exams/Preview/1">Xem trước</a>
                </nav>
            </div>
            <div class="flex items-center gap-4">
                <a class="inline-flex items-center gap-2 bg-surface-container hover:bg-surface-container-high text-on-surface text-xs font-semibold px-4 py-2 rounded-lg transition-all" href="/Exams">
                    <span class="material-symbols-outlined text-[18px]">arrow_back</span>
                    <span>Quay lại danh sách</span>
                </a>
            </div>
        </div>
    </header>

    <main class="w-full pt-20 pb-16">
        <div class="max-w-[1400px] mx-auto px-6 flex flex-col gap-6">
            <!-- Alert nếu có lỗi kiểm tra file Word -->
            @if (Model != null && !Model.Success && Model.ValidationErrors.Count > 0)
            {
                <div class="p-6 rounded-2xl bg-error-container/40 border border-error text-error shadow-sm flex flex-col gap-3">
                    <div class="flex items-center gap-2 font-bold text-base">
                        <span class="material-symbols-outlined text-[24px]">cancel</span>
                        <span>PHÁT HIỆN SAI ĐỊNH DẠNG FILE WORD! HỆ THỐNG ĐÃ HỦY BỎ KHÔNG LƯU VÀO CSDL</span>
                    </div>
                    <p class="text-xs text-on-surface-variant leading-relaxed">
                        Chỉ khi file đạt 100% chuẩn (đủ thẻ tags, đủ 4 đáp án A-B-C-D, có [KEY:], đúng thứ tự câu), hệ thống mới ghi nhận đề thi. Vui lòng sửa các lỗi sau:
                    </p>
                    <div class="bg-white p-4 rounded-xl border border-error/30 max-h-60 overflow-y-auto">
                        <ul class="list-disc list-inside text-xs font-semibold space-y-1">
                            @foreach (var err in Model.ValidationErrors)
                            {
                                <li>@err</li>
                            }
                        </ul>
                    </div>
                </div>
            }

            <div class="grid grid-cols-12 gap-6 items-start">
                <!-- Dropzone Upload Card -->
                <div class="col-span-12 lg:col-span-7 bg-white rounded-2xl p-8 shadow-sm border border-outline-variant/30 flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between mb-4">
                            <h2 class="text-xl font-bold text-on-surface">Tải lên tệp đề thi (.docx)</h2>
                            <span class="px-2.5 py-1 rounded-full bg-surface-container text-xs font-semibold text-primary">MS Word 2016+</span>
                        </div>
                        <p class="text-xs text-on-surface-variant mb-6">
                            Chọn tệp đề thi được biên soạn bằng Microsoft Word (.docx). Đề thi phải tuân thủ nghiêm ngặt chuẩn bộ thẻ Tags của hệ thống.
                        </p>

                        <form action="/Exams/Upload" method="post" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()
                            <label for="docxFile" class="group border-2 border-dashed border-outline-variant hover:border-primary bg-surface-container-low/40 hover:bg-surface-container-low rounded-2xl p-10 flex flex-col items-center justify-center text-center cursor-pointer transition-all">
                                <div class="w-16 h-16 rounded-2xl bg-primary/10 text-primary flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                                    <span class="material-symbols-outlined text-[36px]">cloud_upload</span>
                                </div>
                                <span class="text-sm font-bold text-on-surface mb-1" id="fileTitle">Nhấp để chọn tệp .docx từ máy tính</span>
                                <span class="text-xs text-on-surface-variant" id="fileSubtitle">Hỗ trợ tệp định dạng .docx (tối đa 15 MB)</span>
                                <input type="file" id="docxFile" name="docxFile" accept=".docx" class="hidden" required onchange="showSelectedFile(this)" />
                            </label>

                            <div class="mt-6 flex items-center justify-between">
                                <a href="/DeThi_TOEIC_Reading_ChuanFormat.docx" download class="inline-flex items-center gap-1.5 text-xs text-primary font-semibold hover:underline">
                                    <span class="material-symbols-outlined text-[16px]">download</span>
                                    <span>Tải file Word mẫu chuẩn (.docx)</span>
                                </a>
                                <button type="submit" class="inline-flex items-center gap-2 bg-primary hover:bg-primary-container text-white text-xs font-bold px-6 py-3 rounded-xl shadow-sm transition-all">
                                    <span class="material-symbols-outlined text-[18px]">play_arrow</span>
                                    <span>Phân tích & Lưu đề thi</span>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Syntax Guide Card -->
                <div class="col-span-12 lg:col-span-5 bg-white rounded-2xl p-6 shadow-sm border border-outline-variant/30 flex flex-col gap-4">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-primary text-[20px]">code</span>
                            <h3 class="font-bold text-base text-on-surface">Cú pháp bộ thẻ Tags chuẩn</h3>
                        </div>
                        <span class="px-2 py-0.5 rounded bg-surface-container text-xs font-semibold text-on-surface-variant">Quy chuẩn v1.0</span>
                    </div>

                    <div class="space-y-3 text-xs">
                        <div>
                            <span class="font-bold text-primary">Part 5 (Câu độc lập 101-130):</span>
                            <pre class="bg-gray-900 text-green-400 p-3 rounded-xl mt-1 font-mono text-[11px] overflow-x-auto leading-relaxed">[PART: 5]
[Q: 101] Ms. Durkin asked for volunteers...
[A] she
[B] her
[C] hers
[D] herself
[KEY: D]</pre>
                        </div>

                        <div>
                            <span class="font-bold text-primary">Part 6 & 7 (Đoạn văn + Câu hỏi):</span>
                            <pre class="bg-gray-900 text-green-400 p-3 rounded-xl mt-1 font-mono text-[11px] overflow-x-auto leading-relaxed">[PART: 6]
[PASSAGE_TITLE: Questions 131-134 refer to...]
[PASSAGE_START]
Nội dung bài đọc quảng cáo/email...
[PASSAGE_END]

[Q: 131]
[A] Đáp án A
[B] Đáp án B
[C] Đáp án C
[D] Đáp án D
[KEY: A]</pre>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <script>
        function showSelectedFile(input) {
            if (input.files && input.files[0]) {
                document.getElementById('fileTitle').innerText = input.files[0].name;
                document.getElementById('fileSubtitle').innerText = (input.files[0].size / 1024).toFixed(1) + " KB - Sẵn sàng tải lên";
            }
        }
    </script>
</body>
</html>
